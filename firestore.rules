rules_version = '2';
// Gatherwell: browsers never read or write Firestore directly.
// All access goes through the server API (firebase-admin), which enforces
// organisation, branch and role permissions on every request.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
