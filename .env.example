# Firebase web app settings (public) — Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server-only: the whole service-account JSON (secret). Firebase console → Project settings → Service accounts
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated emails allowed into /platform
PLATFORM_ADMIN_EMAILS=
